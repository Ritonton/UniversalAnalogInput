# Sentry Error Tracking Configuration
# Copy this file to .env and fill in your Sentry DSNs

# Native Component (Rust/Tray) - Sentry DSN
# Get this from your Sentry project settings (Native project)
NATIVE_SENTRY_DSN=https://your-key@sentry.io/native-project-id

# UI Component (WinUI 3/C#) - Sentry DSN
# Get this from your Sentry project settings (UI project)
UI_SENTRY_DSN=https://your-key@sentry.io/ui-project-id

# Environment name for Sentry events
# Use "development" for local development, "production" for releases
# This helps separate dev errors from production errors in Sentry dashboard
SENTRY_ENVIRONMENT=development
